<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TexSharp is a submodule in lib. A program that uses several of these libraries sets JpaLibRoot so they share one. -->
    <JpaLibRoot Condition="'$(JpaLibRoot)' == ''">$(MSBuildThisFileDirectory)..\..\lib</JpaLibRoot>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JParticleSharp</RootNamespace>
    <AssemblyName>JParticleSharp</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Aiden A</Authors>
    <Description>JSystem JParticle (JPAC) particle container reader and writer.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(JpaLibRoot)\TexSharp\src\TexSharp\TexSharp.csproj" />
  </ItemGroup>

</Project>
